#!/usr/bin/env python3
"""Structured edits to ``design/economy.md``'s frontmatter, for ``game-mechanics``.

Queries, mutations, and analysis over the economy graph's ``nodes``,
``connections``, ``families``, and ``updated`` -- one command per change, so a
one-edge change never means re-typing the file. The prose body is never
written: a mutation replaces only the frontmatter block, and every byte from
the closing ``---`` onward is left exactly as it was.

Every mutation parses the file, applies its one change in memory,
re-serializes the frontmatter, validates the whole result, and writes only if
it is valid, setting ``updated`` to the current UTC minute. A refused mutation
writes nothing and prints one message on stderr naming the record, the rule,
and the fix. A file whose frontmatter is not already in the canonical form the
serializer writes is refused rather than silently reformatted.

Parsing, validation, and serialization all come from ``game-gdd``'s
``economy_frontmatter.py``: there is one parser of this format, not two.

Run from the consuming project's working directory. Stdlib only.
"""

import argparse
import datetime
import os
import re
import shutil
import sys
import tempfile

_SCRIPTS_DIR = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(
    0,
    os.path.normpath(
        os.path.join(_SCRIPTS_DIR, os.pardir, os.pardir, "game-gdd", "scripts")
    ),
)

from economy_frontmatter import (  # noqa: E402
    ECONOMY_REL,
    InvalidInput,
    as_list,
    as_text,
    check_flow_style,
    family_name,
    format_flow_mapping,
    frontmatter_span,
    parse_economy,
    parse_frontmatter,
    serialize_economy_frontmatter,
)

NODE_TYPES = ("pool", "source", "drain", "gate", "trader", "converter")
KINDS = ("resource", "state")
SUBTYPES = ("label-modifier", "node-modifier", "trigger", "activator")
APPLIES = ("one-of-family",)
# The two node types that handle more than one resource type, so a resource
# connection touching one must name what moves.
MULTI_RESOURCE_TYPES = ("trader", "converter")
# The three record lists in canonical order, for placing one the first time a
# command adds to it.
RECORD_KEYS = ("nodes", "families", "connections")
_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")


class ToolError(Exception):
    """A refused command. Carries the whole stderr message."""


# ---------------------------------------------------------------------------
# Reading the file
# ---------------------------------------------------------------------------


class EconomyFile(object):
    """``design/economy.md`` as read: its exact text, where the frontmatter
    block sits in it, and that block parsed into ordered fields."""

    def __init__(self, path):
        if not os.path.isfile(path):
            raise ToolError(
                "%s does not exist; write the economy graph with "
                "`game-mechanics` first." % path
            )
        with open(path, "r", encoding="utf-8", newline="") as handle:
            self.text = handle.read()
        span = frontmatter_span(self.text, ECONOMY_REL, "game-mechanics")
        if span is None:
            raise ToolError(
                "design/economy.md: the file has no `---` frontmatter block, so "
                "it declares no `nodes` or `connections`; fix it with "
                "`game-mechanics`."
            )
        self.path = path
        self.start, self.end, self.body_start = span
        self.fm_text = self.text[self.start:self.end]
        self.fields = parse_frontmatter(self.fm_text, ECONOMY_REL, "game-mechanics")


def records(fields, key):
    """The mappings listed under ``key``, in file order; ``[]`` when absent."""
    return [r for r in as_list(fields.get(key)) if isinstance(r, dict)]


def rid(record):
    """A node's or connection's ``id``, stripped."""
    return as_text(record.get("id", "")).strip()


def end_ref(conn, end):
    """A connection's ``from`` or ``to`` reference, stripped."""
    return as_text(conn.get(end, "")).strip()


def strip_at(name):
    return name[1:] if name.startswith("@") else name


def find_node(fields, node_id):
    for node in records(fields, "nodes"):
        if rid(node) == node_id:
            return node
    raise ToolError("design/economy.md: no node has `id: %s`." % node_id)


def find_connection(fields, conn_id):
    for conn in records(fields, "connections"):
        if rid(conn) == conn_id:
            return conn
    raise ToolError("design/economy.md: no connection has `id: %s`." % conn_id)


def find_family(fields, name):
    for family in records(fields, "families"):
        if family_name(family) == name:
            return family
    raise ToolError("design/economy.md: no family is named `@%s`." % name)


def touching(fields, node_id):
    """Connections whose ``from`` or ``to`` is ``node_id`` itself."""
    return [
        c for c in records(fields, "connections")
        if node_id in (end_ref(c, "from"), end_ref(c, "to"))
    ]


def targeting(fields, conn_id):
    """Connections whose ``from`` or ``to`` is ``#conn_id``, or one of its
    derived ids ``#conn_id:<member>``."""
    out = []
    for conn in records(fields, "connections"):
        for end in ("from", "to"):
            ref = end_ref(conn, end)
            if ref == "#" + conn_id or ref.startswith("#%s:" % conn_id):
                out.append(conn)
                break
    return out


def families_of(fields, node_id):
    return [
        family_name(f) for f in records(fields, "families")
        if node_id in as_list(f.get("members"))
    ]


def declarations_over(fields, name):
    return [
        c for c in records(fields, "connections")
        if "@" + name in (end_ref(c, "from"), end_ref(c, "to"))
    ]


def block_lines(key, record):
    """``record`` exactly as the file writes it under ``key``, one line each."""
    return serialize_economy_frontmatter({key: [record]}).split("\n")[1:]


# ---------------------------------------------------------------------------
# Query commands (read-only)
# ---------------------------------------------------------------------------


def print_connections(label, conns):
    if not conns:
        print("%s: none" % label)
        return
    print("%s (%d):" % (label, len(conns)))
    for conn in conns:
        print("  - %s" % format_flow_mapping(conn))


def cmd_list_nodes(args, now):
    doc = EconomyFile(args.file)
    nodes = [
        n for n in records(doc.fields, "nodes")
        if not args.type or as_text(n.get("type", "")).strip() == args.type
    ]
    if not nodes:
        print("No nodes%s." % (" of type `%s`" % args.type if args.type else ""))
        return 0
    width = max(len(rid(n)) for n in nodes)
    for node in nodes:
        print("%-*s  %s" % (width, rid(node), as_text(node.get("type", "")).strip()))
    return 0


def cmd_show_node(args, now):
    doc = EconomyFile(args.file)
    node = find_node(doc.fields, args.id)
    print("node `%s`:" % args.id)
    for line in block_lines("nodes", node):
        print(line)
    fams = families_of(doc.fields, args.id)
    print("families: %s" % (", ".join("@" + f for f in fams) if fams else "none"))
    print_connections("connections touching it", touching(doc.fields, args.id))
    for fam in fams:
        print_connections("declarations over @%s" % fam, declarations_over(doc.fields, fam))
    return 0


def cmd_list_connections(args, now):
    doc = EconomyFile(args.file)
    wanted = (
        ("from", args.from_ref),
        ("to", args.to_ref),
        ("kind", args.kind),
        ("subtype", args.subtype),
    )
    conns = [
        c for c in records(doc.fields, "connections")
        if all(v is None or as_text(c.get(k, "")).strip() == v for k, v in wanted)
    ]
    if not conns:
        print("No connections match.")
        return 0
    for conn in conns:
        print(format_flow_mapping(conn))
    return 0


def cmd_show_connection(args, now):
    doc = EconomyFile(args.file)
    conn = find_connection(doc.fields, args.id)
    print("connection `%s`:" % args.id)
    print("  - %s" % format_flow_mapping(conn))
    print_connections("state connections targeting it", targeting(doc.fields, args.id))
    return 0


def cmd_list_families(args, now):
    doc = EconomyFile(args.file)
    fams = records(doc.fields, "families")
    if not fams:
        print("No families.")
        return 0
    width = max(len(family_name(f)) + 1 for f in fams)
    for fam in fams:
        print(
            "%-*s  %s  %s"
            % (
                width,
                "@" + family_name(fam),
                as_text(fam.get("type", "")).strip(),
                ", ".join(as_list(fam.get("members"))),
            )
        )
    return 0


def cmd_show_family(args, now):
    doc = EconomyFile(args.file)
    name = strip_at(args.name)
    family = find_family(doc.fields, name)
    print("family `@%s`:" % name)
    for line in block_lines("families", family):
        print(line)
    print_connections("declarations over it", declarations_over(doc.fields, name))
    return 0


# ---------------------------------------------------------------------------
# Writing the file
# ---------------------------------------------------------------------------


def edit_records(fields, key):
    """The list under ``key`` itself, so editing it edits the document --
    created empty, in its canonical place among the record lists, if absent."""
    value = fields.get(key)
    if isinstance(value, list):
        return value
    if key in fields:
        fields[key] = []
        return fields[key]
    items = list(fields.items())
    rank = RECORD_KEYS.index(key)
    earlier = [i for i, (k, _) in enumerate(items) if k in RECORD_KEYS[:rank]]
    later = [i for i, (k, _) in enumerate(items) if k in RECORD_KEYS[rank + 1:]]
    if earlier:
        position = earlier[-1] + 1
    elif later:
        position = later[0]
    else:
        position = len(items)
    items.insert(position, (key, []))
    fields.clear()
    fields.update(items)
    return fields[key]


def type_of(fields, ref):
    """The node ``type`` a bare or ``@family`` reference names, or ``""``."""
    if ref.startswith("@"):
        for family in records(fields, "families"):
            if family_name(family) == ref[1:]:
                return as_text(family.get("type", "")).strip()
        return ""
    for node in records(fields, "nodes"):
        if rid(node) == ref:
            return as_text(node.get("type", "")).strip()
    return ""


def canonical_problem(doc):
    """Why ``doc``'s frontmatter is not in the canonical form the serializer
    writes, or None when writing it back unchanged reproduces it exactly."""
    try:
        canonical = serialize_economy_frontmatter(doc.fields)
    except ValueError as exc:
        return "the frontmatter holds a value this tool cannot write back unchanged (%s)" % exc
    if canonical == doc.fm_text:
        return None
    found_lines = doc.fm_text.split("\n")
    wanted_lines = canonical.split("\n")
    for index in range(max(len(found_lines), len(wanted_lines))):
        found = found_lines[index] if index < len(found_lines) else "<end of block>"
        wanted = wanted_lines[index] if index < len(wanted_lines) else "<end of block>"
        if found != wanted:
            # +2: the block starts on the line after the opening `---`.
            return (
                "line %d of the file, `%s`, is not in the canonical form this "
                "tool writes (`%s`)" % (index + 2, found, wanted)
            )


def prose_mentions(doc, ident):
    """``(line number, snippet)`` for each body line naming ``ident`` as a
    whole id -- never as part of a longer id, a ``#connection``, or an
    ``@family``."""
    pattern = re.compile(
        r"(?<![A-Za-z0-9_#@-])%s(?![A-Za-z0-9_-])" % re.escape(ident)
    )
    first = doc.text.count("\n", 0, doc.body_start) + 1
    hits = []
    for lineno, line in enumerate(doc.text[doc.body_start:].split("\n"), start=first):
        match = pattern.search(line)
        if match:
            hits.append((lineno, snippet(line, match)))
    return hits


def snippet(line, match, width=40):
    """The part of ``line`` around ``match``, elided at either end if long."""
    start = max(0, match.start() - width)
    end = min(len(line), match.end() + width)
    return "%s%s%s" % (
        "…" if start else "",
        line[start:end].strip(),
        "…" if end < len(line) else "",
    )


def mutate(path, change, now):
    """Apply ``change`` to the file at ``path`` and write it -- only if valid.

    ``change(fields)`` edits the parsed frontmatter in place and returns a
    one-line summary, or raises ToolError to refuse. Returns ``(summary,
    doc)``, ``doc`` being the file as read; its body is also the body now on
    disk, untouched. Any refusal leaves the file exactly as it was.
    """
    try:
        doc = EconomyFile(path)
        check_flow_style(doc.fm_text)
        problem = canonical_problem(doc)
        if problem:
            raise ToolError(
                "design/economy.md: %s, so rewriting the block would reformat "
                "content this command was not asked to touch; fix the "
                "formatting with `game-mechanics`." % problem
            )
        try:
            summary = change(doc.fields)
        except ValueError as exc:
            raise ToolError("design/economy.md: %s." % exc)
        doc.fields["updated"] = now
        try:
            fm_text = serialize_economy_frontmatter(doc.fields)
        except ValueError as exc:
            raise ToolError("design/economy.md: %s." % exc)
        text = doc.text[:doc.start] + fm_text + doc.text[doc.end:]
        parse_economy(text, headings=False)
    except (ToolError, InvalidInput) as exc:
        raise ToolError("%s Nothing was written." % exc)
    write_atomically(path, text)
    return summary, doc


def write_atomically(path, text):
    """Replace ``path`` with ``text`` in one rename, so a reader never sees a
    half-written file."""
    directory = os.path.dirname(os.path.abspath(path))
    handle, tmp = tempfile.mkstemp(prefix=".economy-", suffix=".tmp", dir=directory)
    try:
        with os.fdopen(handle, "w", encoding="utf-8", newline="") as out:
            out.write(text)
        shutil.copymode(path, tmp)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def run_mutation(args, now, change):
    summary, doc = mutate(args.file, change, now)
    print("%s; `updated` is now %s." % (summary, now))
    return doc


def print_prose_followup(doc, ident):
    hits = prose_mentions(doc, ident)
    if not hits:
        return
    print(
        "Prose still naming `%s` — rewrite each by hand; this tool never writes "
        "prose:" % ident
    )
    for lineno, text in hits:
        print("  line %d: %s" % (lineno, text))


def check_id(value, what):
    if not _ID_RE.match(value):
        raise ToolError(
            "`%s` is not a usable %s id: an id is letters, digits, `-`, `_`, "
            "and `.`, starting with a letter or digit." % (value, what)
        )


def code_list(items):
    return ", ".join("`%s`" % item for item in items)


# ---------------------------------------------------------------------------
# Mutating commands (frontmatter only)
# ---------------------------------------------------------------------------


def cmd_add_node(args, now):
    def change(fields):
        check_id(args.id, "node")
        if any(rid(n) == args.id for n in records(fields, "nodes")):
            raise ToolError("design/economy.md: node `%s` already exists." % args.id)
        edit_records(fields, "nodes").append({"id": args.id, "type": args.type})
        return "added node `%s` (%s)" % (args.id, args.type)

    run_mutation(args, now, change)
    return 0


def cmd_remove_node(args, now):
    def change(fields):
        node = find_node(fields, args.id)
        refs = ["connection `%s`" % rid(c) for c in touching(fields, args.id)]
        refs += ["family `@%s`" % f for f in families_of(fields, args.id)]
        if refs:
            raise ToolError(
                "design/economy.md: node `%s` is still referenced by %s; "
                "re-point or remove those first — `remove-node` never cascades."
                % (args.id, ", ".join(refs))
            )
        nodes = edit_records(fields, "nodes")
        nodes[:] = [n for n in nodes if n is not node]
        return "removed node `%s`" % args.id

    doc = run_mutation(args, now, change)
    print_prose_followup(doc, args.id)
    return 0


def new_connection(fields, args):
    """The connection ``args`` describe, refused where ``game-mechanics``'
    connection rules forbid it."""
    src, dst = args.from_ref, args.to_ref
    if src.startswith("@") and dst.startswith("@"):
        raise ToolError(
            "connection `%s`: a family reference may appear on at most one end "
            "of a connection, not both." % args.id
        )
    if args.kind == "resource":
        for end, ref in (("from", src), ("to", dst)):
            if ref.startswith("#"):
                raise ToolError(
                    "connection `%s`: `%s: %s` names a connection, but only a "
                    "`state` connection may target one; a `resource` "
                    "connection's ends are nodes or a family." % (args.id, end, ref)
                )
        if args.subtype:
            raise ToolError(
                "connection `%s`: `subtype` is meaningful only on a `state` "
                "connection." % args.id
            )
        if not args.resource:
            multi = [r for r in (src, dst) if type_of(fields, r) in MULTI_RESOURCE_TYPES]
            if multi:
                raise ToolError(
                    "connection `%s`: a `resource` connection touching a trader "
                    "or converter (`%s`) must name what moves, with "
                    "`--resource`." % (args.id, multi[0])
                )
    else:
        if args.resource:
            raise ToolError(
                "connection `%s`: `resource` is meaningful only on a `resource` "
                "connection." % args.id
            )
        if args.rate and args.subtype != "label-modifier":
            raise ToolError(
                "connection `%s`: on a `state` connection `rate` expresses only "
                "the `label-modifier` case, so it needs `--subtype "
                "label-modifier`." % args.id
            )
    if args.applies and not (
        args.kind == "state" and (src.startswith("@") or dst.startswith("@"))
    ):
        raise ToolError(
            "connection `%s`: `applies: one-of-family` qualifies only a `state` "
            "connection written over a family (`@<name>` on one end)." % args.id
        )
    conn = {"id": args.id, "from": src, "to": dst, "kind": args.kind}
    for key, value in (
        ("subtype", args.subtype),
        ("resource", args.resource),
        ("rate", args.rate),
        ("applies", args.applies),
    ):
        if value:
            conn[key] = value
    return conn


def cmd_add_connection(args, now):
    def change(fields):
        if ":" in args.id:
            raise ToolError(
                "`%s`: an authored connection id may not contain `:`, which is "
                "reserved for the derived ids a family declaration produces."
                % args.id
            )
        check_id(args.id, "connection")
        if any(rid(c) == args.id for c in records(fields, "connections")):
            raise ToolError(
                "design/economy.md: connection `%s` already exists." % args.id
            )
        conn = new_connection(fields, args)
        edit_records(fields, "connections").append(conn)
        return "added `%s`" % format_flow_mapping(conn)

    run_mutation(args, now, change)
    return 0


def cmd_remove_connection(args, now):
    def change(fields):
        conn = find_connection(fields, args.id)
        users = targeting(fields, args.id)
        if users:
            raise ToolError(
                "design/economy.md: connection `%s` is still targeted by %s; "
                "re-point or remove those first — `remove-connection` never "
                "cascades."
                % (args.id, ", ".join("connection `%s`" % rid(c) for c in users))
            )
        conns = edit_records(fields, "connections")
        conns[:] = [c for c in conns if c is not conn]
        return "removed connection `%s`" % args.id

    run_mutation(args, now, change)
    return 0


def check_member_type(fields, name, family_type, member):
    node = find_node(fields, member)
    node_type = as_text(node.get("type", "")).strip()
    if node_type != family_type:
        raise ToolError(
            "family `@%s`: member `%s` is a `%s`, but every member of a family "
            "is of the family's declared type, `%s`."
            % (name, member, node_type or "none recorded", family_type)
        )


def cmd_add_family(args, now):
    def change(fields):
        name = strip_at(args.name)
        check_id(name, "family")
        if any(family_name(f) == name for f in records(fields, "families")):
            raise ToolError("design/economy.md: family `@%s` already exists." % name)
        members = [m.strip() for m in args.members.split(",") if m.strip()]
        if not members:
            raise ToolError("family `@%s`: `--members` names no node." % name)
        for index, member in enumerate(members):
            if member in members[:index]:
                raise ToolError(
                    "family `@%s`: `%s` is listed twice in `--members`." % (name, member)
                )
            check_member_type(fields, name, args.type, member)
        edit_records(fields, "families").append(
            {"family": name, "type": args.type, "members": members}
        )
        return "added family `@%s` (%s): %s" % (name, args.type, ", ".join(members))

    run_mutation(args, now, change)
    return 0


def cmd_add_family_member(args, now):
    def change(fields):
        name = strip_at(args.name)
        family = find_family(fields, name)
        members = as_list(family.get("members"))
        if args.id in members:
            raise ToolError("family `@%s` already lists `%s`." % (name, args.id))
        check_member_type(fields, name, as_text(family.get("type", "")).strip(), args.id)
        family["members"] = members + [args.id]
        return "added `%s` to family `@%s`" % (args.id, name)

    run_mutation(args, now, change)
    return 0


def cmd_remove_family_member(args, now):
    def change(fields):
        name = strip_at(args.name)
        family = find_family(fields, name)
        members = as_list(family.get("members"))
        if args.id not in members:
            raise ToolError("family `@%s` does not list `%s`." % (name, args.id))
        family["members"] = [m for m in members if m != args.id]
        return "removed `%s` from family `@%s`" % (args.id, name)

    run_mutation(args, now, change)
    return 0


def cmd_rename_node(args, now):
    def change(fields):
        node = find_node(fields, args.old)
        check_id(args.new, "node")
        if any(rid(n) == args.new for n in records(fields, "nodes")):
            raise ToolError("design/economy.md: node `%s` already exists." % args.new)
        node["id"] = args.new
        conns = []
        for conn in touching(fields, args.old):
            for end in ("from", "to"):
                if end_ref(conn, end) == args.old:
                    conn[end] = args.new
            conns.append(rid(conn))
        fams = []
        for family in records(fields, "families"):
            members = as_list(family.get("members"))
            if args.old in members:
                family["members"] = [args.new if m == args.old else m for m in members]
                fams.append(family_name(family))
        where = []
        if conns:
            where.append("connections %s" % code_list(conns))
        if fams:
            where.append("families %s" % code_list("@" + f for f in fams))
        return "renamed node `%s` to `%s`%s" % (
            args.old,
            args.new,
            " in %s" % " and ".join(where) if where else "",
        )

    doc = run_mutation(args, now, change)
    print_prose_followup(doc, args.old)
    print(
        "Other records may cite it as `[[node:%s]]`; list them with "
        "`game-gdd`'s `scripts/find_references.py node:%s`." % (args.old, args.old)
    )
    return 0


def cmd_set_value_progression(args, now):
    def change(fields):
        node = find_node(fields, args.id)
        verb = "replaced" if "value_progression" in node else "set"
        node["value_progression"] = {
            "model": args.model,
            "coefficients": args.coefficients,
            "domain": args.domain,
            "fit": args.fit,
        }
        return "%s `value_progression` on node `%s` (model %s, fit %s)" % (
            verb,
            args.id,
            args.model,
            args.fit,
        )

    run_mutation(args, now, change)
    return 0


# ---------------------------------------------------------------------------
# Command line
# ---------------------------------------------------------------------------


def build_parser():
    parser = argparse.ArgumentParser(
        prog="economy-tool",
        description=(
            "Query and edit design/economy.md's frontmatter -- nodes, "
            "connections, families, updated. Never writes the prose body. "
            "Every mutation validates the whole result before writing it, and "
            "sets `updated` to the current UTC minute."
        ),
    )
    parser.add_argument(
        "--file",
        default=ECONOMY_REL,
        help="the economy graph to read (default: %(default)s, relative to the working directory)",
    )
    sub = parser.add_subparsers(dest="command", metavar="<command>")
    sub.required = True

    def command(name, run, help_text):
        p = sub.add_parser(name, help=help_text, description=help_text)
        p.set_defaults(run=run)
        return p

    p = command("list-nodes", cmd_list_nodes, "list every node's id and type (read-only)")
    p.add_argument("--type", choices=NODE_TYPES)

    p = command(
        "show-node",
        cmd_show_node,
        "one node's fields, its families, every connection touching it, and "
        "the declarations over its families (read-only)",
    )
    p.add_argument("id")

    p = command(
        "list-connections",
        cmd_list_connections,
        "list connections as their one-line flow mappings, optionally filtered (read-only)",
    )
    p.add_argument("--from", dest="from_ref", metavar="REF", help="exact `from`, sigil included")
    p.add_argument("--to", dest="to_ref", metavar="REF", help="exact `to`, sigil included")
    p.add_argument("--kind", choices=KINDS)
    p.add_argument("--subtype", choices=SUBTYPES)

    p = command(
        "show-connection",
        cmd_show_connection,
        "one connection, and every state connection targeting it (read-only)",
    )
    p.add_argument("id")

    command("list-families", cmd_list_families, "list every family's name, type, and members (read-only)")

    p = command("show-family", cmd_show_family, "one family, and the declarations over it (read-only)")
    p.add_argument("name", help="the family name, with or without its `@`")

    p = command("add-node", cmd_add_node, "add a node")
    p.add_argument("id")
    p.add_argument("--type", required=True, choices=NODE_TYPES)

    p = command(
        "remove-node",
        cmd_remove_node,
        "remove a node no connection or family references; never cascades",
    )
    p.add_argument("id")

    p = command("add-connection", cmd_add_connection, "add a connection")
    p.add_argument("id")
    p.add_argument("--from", dest="from_ref", required=True, metavar="REF",
                   help="a node id, `@family`, or (state only) `#connection`")
    p.add_argument("--to", dest="to_ref", required=True, metavar="REF",
                   help="a node id, `@family`, or (state only) `#connection`")
    p.add_argument("--kind", required=True, choices=KINDS)
    p.add_argument("--subtype", choices=SUBTYPES, help="state connections only; absent means unclassified")
    p.add_argument("--resource", help="resource connections only; required where one end is a trader or converter")
    p.add_argument("--rate")
    p.add_argument("--applies", choices=APPLIES, help="a state declaration over a family only")

    p = command(
        "remove-connection",
        cmd_remove_connection,
        "remove a connection no state connection targets; never cascades",
    )
    p.add_argument("id")

    p = command("add-family", cmd_add_family, "declare a family over existing same-type nodes")
    p.add_argument("name", help="the family name, with or without its `@`")
    p.add_argument("--type", required=True, choices=NODE_TYPES)
    p.add_argument("--members", required=True, metavar="A,B,C")

    p = command("add-family-member", cmd_add_family_member, "add an existing node to a family")
    p.add_argument("name")
    p.add_argument("id")

    p = command("remove-family-member", cmd_remove_family_member, "remove a node from a family")
    p.add_argument("name")
    p.add_argument("id")

    p = command(
        "rename-node",
        cmd_rename_node,
        "rename a node through its connections and family memberships; prints "
        "the prose lines still naming the old id, never edits them",
    )
    p.add_argument("old")
    p.add_argument("new")

    p = command(
        "set-value-progression",
        cmd_set_value_progression,
        "write the four fields `curve-fit.sh fit` prints into a node's "
        "value_progression; a value starting with `-` is passed as "
        "--coefficients=VALUE",
    )
    p.add_argument("id")
    p.add_argument("--model", required=True)
    p.add_argument("--coefficients", required=True)
    p.add_argument("--domain", required=True)
    p.add_argument("--fit", required=True)

    return parser


def utc_now():
    """The current UTC minute, in ``game-authoring``'s ``updated`` form."""
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%MZ")


def main(argv=None, now=None):
    args = build_parser().parse_args(argv)
    try:
        return args.run(args, now or utc_now())
    except (ToolError, InvalidInput) as exc:
        sys.stderr.write("%s\n" % exc)
        return 1


if __name__ == "__main__":
    sys.exit(main())
